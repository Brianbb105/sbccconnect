  "notes": [
    {
      "id": "aeafed80-9055-4495-95d5-01931c1a1189",
      "type": "GeneralTitle",
      "area": "General",
      "position": 0,
      "content": "Criminology, B.A. (Degree Completion)",
      "contentHtml": null
    },
    {
      "id": "1efe6706-eefe-4c02-8a69-01931c1a1189",
      "type": "GeneralText",
      "area": "General",
      "position": 1,
      "content": "ABOUT THE MAJOR The Bachelor of Arts in Criminology is designed for adults who have an interest in criminology, restorative justice, and the issues of victims. The program equips students to be knowledgeable about crime and society with a view to careers in fields related to criminology. Class time and coursework focus on implementing approaches to justice and understanding the various social and psychological theories on crime, criminals and society. Candidates will also learn to incorporate the values of a Christian/Anabaptist worldview into their work. **Agreement does not include all required courses for the major at FPU** This agreement lists courses that are prerequisites or may be completed prior to transfer to satisfy major requirements. All transfer courses must be completed with a grade of C- or better, and students must complete a minimum of 18 units in the major at FPU. Please contact an academic advisor to discuss the recommended sequence of courses, including courses that may count for both GE and major requirements. To view the full degree requirements, please refer to the Undergraduate Catalog: https://catalog.fresno.edu/index.php .",
      "contentHtml": "<p><strong style=\"font-size: 14px; color: rgb(22, 43, 132);\">ABOUT THE MAJOR</strong></p><p><span style=\"font-size: 14px;\">The Bachelor of Arts in Criminology&nbsp;is designed for adults who have an interest in criminology, restorative justice, and the issues of victims. The program equips students to be knowledgeable about crime and society with a view to careers in fields related to criminology. Class time and coursework focus on implementing&nbsp;approaches to justice and understanding the various social and psychological theories on crime, criminals and society. Candidates will also learn to incorporate the values of a Christian/Anabaptist worldview into their work.</span></p><p><br></p><p><strong style=\"font-size: 14px; color: rgb(169, 62, 58);\">﻿**Agreement does not include all required courses for the major at FPU**</strong></p><p><span style=\"font-size: 14px;\">This agreement lists courses that are prerequisites or may be completed prior to transfer to satisfy major requirements. All transfer courses must be completed with a grade of C- or better, and students must complete a minimum of 18 units in the major at FPU. Please contact an academic advisor to discuss the recommended sequence of courses, including courses that may count for both GE and major requirements.&nbsp;To view the full degree requirements, please refer to the Undergraduate Catalog: </span><a href=\"https://catalog.fresno.edu/index.php\" rel=\"noopener noreferrer\" target=\"_blank\" style=\"font-size: 14px;\">https://catalog.fresno.edu/index.php</a><span style=\"font-size: 14px;\">.</span></p>"
    }
  ],
