  "notes": [
    {
      "id": "e60f6f85-d240-4c9f-b5dc-01931c395c1f",
      "type": "GeneralTitle",
      "area": "General",
      "position": 0,
      "content": "Liberal Arts - Education Concentration, B.A. (Degree Completion)",
      "contentHtml": null
    },
    {
      "id": "fae850f7-9316-4557-be05-01931c395c1f",
      "type": "GeneralText",
      "area": "General",
      "position": 1,
      "content": "ABOUT THE MAJOR The Bachelor of Arts in Liberal Arts is an accelerated degree completion major designed for students interested in a broad, multi-disciplinary education. This major includes coursework in the areas required by the state of California to meet subject matter competency for individuals pursuing a multiple subject teaching credential. Accordingly, the program is recommended for those interested in teaching at the elementary school level, as well as those desiring a liberal arts education relevant to many other careers in education, government, non-profits and health care service among others. Core courses are blended and meet one evening per week for four hours in a cohort setting with additional on-line assignments. Courses are typically six weeks in length. **Agreement does not include all required courses for the major at FPU** This agreement lists courses that are prerequisites or may be completed prior to transfer to satisfy major requirements. All transfer courses must be completed with a grade of C- or better, and students must complete a minimum of 18 units in the major at FPU. Please contact an academic advisor to discuss the recommended sequence of courses, including courses that may count for both GE and major requirements. To view the full degree requirements, please refer to the Undergraduate Catalog: https://catalog.fresno.edu/index.php .",
      "contentHtml": "<p><strong style=\"color: rgb(22, 43, 132); font-size: 14px;\">ABOUT THE MAJOR</strong></p><p><span style=\"font-size: 14px;\">The Bachelor of Arts in Liberal Arts is an accelerated degree completion major designed for students&nbsp;interested in a broad, multi-disciplinary education. This major includes coursework in the areas required by the state of California to meet subject matter competency for individuals pursuing a&nbsp;multiple subject teaching credential. Accordingly, the program is recommended for those interested in teaching at the elementary school level, as well as those desiring a liberal arts education relevant to many other careers in education, government, non-profits and health care service among others. Core courses are blended and meet one evening per week for four hours in a cohort setting with additional on-line assignments. Courses are typically six weeks in length.</span></p><p><br></p><p><strong style=\"color: rgb(169, 62, 58); font-size: 14px;\">﻿**Agreement does not include all required courses for the major at FPU**</strong></p><p><span style=\"font-size: 14px;\">This agreement lists courses that are prerequisites or may be completed prior to transfer to satisfy major requirements. All transfer courses must be completed with a grade of C- or better, and students must complete a minimum of 18 units in the major at FPU. Please contact an academic advisor to discuss the recommended sequence of courses, including courses that may count for both GE and major requirements.&nbsp;To view the full degree requirements, please refer to the Undergraduate Catalog: </span><a href=\"https://catalog.fresno.edu/index.php\" rel=\"noopener noreferrer\" target=\"_blank\" style=\"font-size: 14px;\">https://catalog.fresno.edu/index.php</a><span style=\"font-size: 14px;\">.</span></p>"
    }
