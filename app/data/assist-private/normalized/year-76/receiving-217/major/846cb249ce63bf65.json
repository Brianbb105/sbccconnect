  "notes": [
    {
      "id": "6a8fc5aa-15f1-43ea-bc40-01944d66c449",
      "type": "GeneralTitle",
      "area": "General",
      "position": 0,
      "content": "Bachelor of Arts Major in Geological and Environmental Sciences",
      "contentHtml": null
    },
    {
      "id": "ca1449ae-2b54-46dc-914c-01944d66c44a",
      "type": "GeneralText",
      "area": "General",
      "position": 1,
      "content": "Students must complete a minimum of 120 units with a cumulative and major/program grade point average of 2.0 in order to earn the Bachelor of Arts degree with a major in geological and environmental science.",
      "contentHtml": "<p><span style=\"font-size: 16px;\">Students must complete a minimum of 120 units with a cumulative and major/program grade point average of 2.0 in order to earn the Bachelor of Arts degree with a major in geological and environmental science.</span></p>"
    },
    {
      "id": "71855719-b265-4313-8c1d-01944d673a4c",
      "type": "GeneralTitle",
      "area": "General",
      "position": 2,
      "content": "General Education Requirements",
      "contentHtml": null
    },
    {
      "id": "7271deef-bda1-4fa5-8513-01944d673a4c",
      "type": "GeneralText",
      "area": "General",
      "position": 3,
      "content": "For more details, see General Education Minimum 28 units and 9 courses that include:",
      "contentHtml": "<p>For more details, see&nbsp;<a href=\"https://catalog.pacific.edu/stocktongeneral/generaleducationprogram/\" rel=\"noopener noreferrer\" target=\"_blank\">General Education</a></p><p>Minimum 28 units and 9 courses that include:</p>"
    },
    {
      "id": "7fd4749e-9b78-4ed5-a1f0-01944d67b753",
      "type": "GeneralTitle",
      "area": "General",
      "position": 4,
      "content": "CORE Seminars (2 courses)",
      "contentHtml": null
    },
    {
      "id": "174f8955-009f-4e9a-a632-01944d67b753",
      "type": "GeneralText",
      "area": "General",
      "position": 5,
      "content": "Notes: 1) CORE Seminars cannot be taken for Pass/No Credit. 2) Transfer students with 28 or more transfer credits taken after high school are exempt from both CORE seminars.",
      "contentHtml": "<p><strong style=\"font-size: 16px;\"><em>Notes: </em></strong></p><p><strong style=\"font-size: 16px;\"><em>1)</em></strong><span style=\"font-size: 16px;\">&nbsp;CORE Seminars cannot be taken for Pass/No Credit.&nbsp;</span></p><p><strong style=\"font-size: 16px;\"><em>2)</em></strong><span style=\"font-size: 16px;\">&nbsp;Transfer students with 28 or more transfer credits taken after high school are exempt from both CORE seminars.&nbsp;&nbsp;</span></p>"
    },
