    {
      "id": "cdaaac44-21ae-4239-92be-01932c72d34e",
      "type": "GeneralText",
      "area": "General",
      "position": 1,
      "content": "Students earning degrees with a Math or an Applied Math major are not required to pass the CSET exams (to demonstrate subject matter competence) for the California Single Subject Math credential. Please contact Dr. Dennis Parker at dparker@pacific.edu for additional credential requirements.",
      "contentHtml": "<p><span style=\"font-size: 16px;\">Students earning degrees with a Math or an Applied Math major are&nbsp;</span><strong style=\"font-size: 16px;\"><u>not</u></strong><span style=\"font-size: 16px;\">&nbsp;required to pass the CSET exams (to demonstrate subject matter competence) for the California Single Subject Math credential. Please contact Dr. Dennis Parker at&nbsp;</span><a href=\"mailto:dparker@pacific.edu\" rel=\"noopener noreferrer\" target=\"_blank\" style=\"font-size: 16px;\">dparker@pacific.edu</a><span style=\"font-size: 16px;\">&nbsp;for additional credential requirements.</span></p>"
    }
