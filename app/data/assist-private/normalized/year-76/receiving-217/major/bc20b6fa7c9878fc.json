  "unlinkedArticulations": [],
  "notes": [
    {
      "id": "2a5625ce-f9c8-49fa-9f99-019596bdf20c",
      "type": "GeneralTitle",
      "area": "General",
      "position": 0,
      "content": "Bachelor of Arts Major in Applied Science",
      "contentHtml": null
    },
    {
      "id": "89bafd55-0e54-433d-9e5e-019596bdf20d",
      "type": "GeneralText",
      "area": "General",
      "position": 1,
      "content": "Students must complete a minimum of 124 units with a Pacific cumulative and major/program grade point average of 2.0 in order to earn the Bachelor of Arts degree with a major in applied science. At least 64 semester (96 quarter) units must be from undergraduate courses and at least 60 semester (90 quarter) units must be from professional doctorate courses.",
      "contentHtml": "<p><span style=\"font-size: 16px;\">Students must complete a minimum of 124 units with a Pacific cumulative and major/program grade point average of 2.0 in order to earn the Bachelor of Arts degree with a major in applied science. At least 64 semester (96 quarter) units must be from undergraduate courses and at least 60 semester (90 quarter) units must be from professional doctorate courses.</span></p>"
    },
    {
      "id": "55c69a0d-567b-4977-bf8b-019596c2df93",
      "type": "GeneralTitle",
      "area": "General",
      "position": 2,
      "content": "General Education Requirements",
      "contentHtml": null
    },
    {
      "id": "99a54a66-28a7-4606-b17e-019596c2df93",
      "type": "GeneralText",
      "area": "General",
      "position": 3,
      "content": "For more details, see General Education Minimum 28 units and 9 courses that include the following requirements.",
      "contentHtml": "<p>For more details, see&nbsp;<a href=\"https://catalog.pacific.edu/stocktongeneral/generaleducationprogram/\" rel=\"noopener noreferrer\" target=\"_blank\">General Education</a></p><p>Minimum 28 units and 9 courses that include the following requirements.</p>"
    },
    {
      "id": "6a2aac64-6ab7-4fcc-b831-019596c2df94",
      "type": "GeneralTitle",
      "area": "General",
      "position": 4,
      "content": "CORE Requirements",
      "contentHtml": null
    },
    {
      "id": "b91c10c9-d169-42f3-9735-019596c2df94",
      "type": "GeneralText",
      "area": "General",
      "position": 5,
      "content": "Notes: 1) CORE Seminars cannot be taken for Pass/No Credit. 2) Transfer students with 28 or more transfer credits taken after high school are exempt from both CORE seminars.",
      "contentHtml": "<p><strong style=\"font-size: 16px;\"><em>Notes: </em></strong></p><p><strong style=\"font-size: 16px;\"><em>1)</em></strong><span style=\"font-size: 16px;\">&nbsp;CORE Seminars cannot be taken for Pass/No Credit.</span></p><p><span style=\"font-size: 16px;\">&nbsp;</span><strong style=\"font-size: 16px;\"><em>2)</em></strong><span style=\"font-size: 16px;\">&nbsp;Transfer students with 28 or more transfer credits taken after high school are exempt from both CORE seminars.&nbsp;</span></p>"
    },
    {
      "id": "859d43a4-1522-4944-bd19-019596c33a45",
      "type": "GeneralTitle",
      "area": "General",
      "position": 6,
      "content": "Breadth Requirement (7 courses, at least 3 units each)",
      "contentHtml": null
    },
    {
      "id": "1c55d4ff-192c-4303-9efa-019596c33a45",
      "type": "GeneralText",
      "area": "General",
      "position": 7,
      "content": "Note: No more than 2 courses from a single discipline can be used to meet the Breadth Requirement.",
      "contentHtml": "<p><strong style=\"font-size: 16px;\"><em>Note: </em></strong><span style=\"font-size: 16px;\">No more than 2 courses from a single discipline can be used to meet the Breadth Requirement.</span></p>"
    },
    {
      "id": "d1e59257-2a59-4580-a1d3-019596c398f8",
      "type": "GeneralTitle",
      "area": "General",
      "position": 8,
      "content": "Diversity and Inclusion Requirement",
      "contentHtml": null
    },
    {
      "id": "c14fabdd-5d0c-46ef-a03d-019596c398f8",
      "type": "GeneralText",
      "area": "General",
      "position": 9,
      "content": "All students must complete Diversity and Inclusion coursework (at least 3 units) Note: Diversity and Inclusion courses can also be used to meet the breadth category requirements, or major or minor requirements.",
      "contentHtml": "<p>All students must complete Diversity and Inclusion coursework (at least 3 units)</p><p><strong><em>Note: </em></strong>Diversity and Inclusion courses can also be used to meet the breadth category requirements, or major or minor requirements.</p>"
    },
    {
      "id": "e3d02b09-2a19-4eed-bc74-019596c5c324",
      "type": "GeneralTitle",
      "area": "General",
      "position": 10,
      "content": "Fundamental Skills",
      "contentHtml": null
    },
    {
      "id": "743689a3-0d5c-44b6-a2d1-019596c5c324",
      "type": "GeneralText",
      "area": "General",
      "position": 11,
      "content": "Students must demonstrate competence in: Writing Quantitative Analysis (Math) Note: Failure to satisfy the fundamental skills requirements by the end of four semesters of full-time study at the University is grounds for academic disqualification.",
      "contentHtml": "<p>Students must demonstrate competence in:</p><p>Writing</p><p>Quantitative Analysis (Math)</p><p><strong><em>Note: </em></strong>&nbsp;Failure to satisfy the fundamental skills requirements by the end of four semesters of full-time study at the University is grounds for academic disqualification.</p>"
    },
    {
      "id": "ae53d9f5-9617-415c-82a4-019596d3ee11",
      "type": "GeneralTitle",
      "area": "General",
      "position": 12,
      "content": "Major Requirements",
      "contentHtml": null
    },
    {
      "id": "beb8ba54-6d77-416c-8f1b-019596d3ee11",
      "type": "GeneralText",
      "area": "General",
      "position": 13,
      "content": "A minimum of 64 semester or 96 quarter units of undergraduate courses is required Of the required 64 (96 quarter) units, 24 (36 quarter) units must be non-science undergraduate courses. These may include Pacific CORE and non-science Breadth Program courses in addition to other non-science courses 2.0 GPA from these units is required to count towards the degree",
      "contentHtml": "<ol><li>A minimum of 64 semester or 96 quarter units of undergraduate courses is required</li><li>Of the required 64 (96 quarter) units, 24 (36 quarter) units must be non-science undergraduate courses. These may include Pacific CORE and non-science Breadth Program courses in addition to other non-science courses</li><li>2.0 GPA from these units is required to count towards the degree</li></ol><p><br></p>"
    }
  ],
