  "notes": [
    {
      "id": "d796a969-3bc3-48d2-bc63-0194529c3e2a",
      "type": "GeneralTitle",
      "area": "General",
      "position": 0,
      "content": "Bachelor of Arts Major in Health and Exercise Sciences Concentration in Human Performance",
      "contentHtml": null
    },
    {
      "id": "ef383104-c0be-466e-8756-0194529c3e2a",
      "type": "GeneralText",
      "area": "General",
      "position": 1,
      "content": "Students must complete a minimum of 120 units with a Pacific cumulative and major/program grade point average of 2.0 in order to earn the Bachelor of Arts degree with a major in health, exercise and sport sciences with a concentration in human performance.",
      "contentHtml": "<p><span style=\"font-size: 16px;\">Students must complete a minimum of 120 units with a Pacific cumulative and major/program grade point average of 2.0 in order to earn the Bachelor of Arts degree with a major in health, exercise and sport sciences with a concentration in human performance.</span></p>"
    },
    {
      "id": "bda1186a-c353-4119-bc9f-0194529db692",
      "type": "GeneralTitle",
      "area": "General",
      "position": 2,
      "content": "General Education Requirements",
      "contentHtml": null
    },
    {
      "id": "924376c0-deac-4dbe-807f-0194529db692",
      "type": "GeneralText",
      "area": "General",
      "position": 3,
      "content": "For more details, see General Education Minimum 28 units and 9 courses that include:",
      "contentHtml": "<p>For more details, see&nbsp;<a href=\"https://catalog.pacific.edu/stocktongeneral/generaleducationprogram/\" rel=\"noopener noreferrer\" target=\"_blank\">General Education</a></p><p>Minimum 28 units and 9 courses that include:</p>"
    },
    {
      "id": "085786f9-619b-4205-924a-0194529f3af9",
      "type": "GeneralTitle",
      "area": "General",
      "position": 4,
      "content": "CORE Seminars (2 courses)",
      "contentHtml": null
    },
    {
      "id": "297af6d7-437c-4364-b56b-0194529f3af9",
      "type": "GeneralText",
      "area": "General",
      "position": 5,
      "content": "Notes: 1) CORE Seminars cannot be taken for Pass/No Credit. 2) Transfer students with 28 or more transfer credits taken after high school are exempt from both CORE seminars.",
      "contentHtml": "<p><strong style=\"font-size: 16px;\"><em>Notes: </em></strong></p><p><strong style=\"font-size: 16px;\"><em>1)</em></strong><span style=\"font-size: 16px;\">&nbsp;CORE Seminars cannot be taken for Pass/No Credit.&nbsp;</span></p><p><strong style=\"font-size: 16px;\"><em>2)</em></strong><span style=\"font-size: 16px;\">&nbsp;Transfer students with 28 or more transfer credits taken after high school are exempt from both CORE seminars.&nbsp;&nbsp;</span></p>"
    },
    {
      "id": "84dc81a0-d373-4bb9-851d-019452a08316",
      "type": "GeneralTitle",
      "area": "General",
      "position": 6,
      "content": "Breadth Requirement (7 courses, at least 3 units each)",
      "contentHtml": null
    },
    {
      "id": "e7a31fa0-917a-4760-b714-019452a08316",
      "type": "GeneralText",
      "area": "General",
      "position": 7,
      "content": "Notes: 1) No more than 2 courses from a single discipline can be used to meet the Breadth Requirement. 2) Students must complete 60 units outside the primary discipline of the first major, regardless of the department who offers the course(s) in that discipline. (Courses include general education courses, transfer courses, CPCE/EXTN units, internships, etc.)",
      "contentHtml": "<p><strong style=\"font-size: 16px;\"><em>Notes: </em></strong></p><p><strong style=\"font-size: 16px;\"><em>1)</em></strong><span style=\"font-size: 16px;\">&nbsp;No more than 2 courses from a single discipline can be used to meet the Breadth Requirement.</span></p><p><strong style=\"font-size: 16px;\"><em>2)</em></strong><span style=\"font-size: 16px;\"> Students must complete 60 units outside the primary discipline of the first major, regardless of the department who offers the course(s) in that discipline. (Courses include general education courses, transfer courses, CPCE/EXTN units, internships, etc.)</span></p>"
    },
    {
      "id": "9ef92895-2243-4174-85c6-019452a08316",
      "type": "GeneralTitle",
      "area": "General",
      "position": 8,
      "content": "Diversity and Inclusion Requirement",
      "contentHtml": null
    },
    {
      "id": "c5620567-c8cb-41f1-8720-019452a08316",
      "type": "GeneralText",
      "area": "General",
      "position": 9,
      "content": "All students must complete Diversity and Inclusion coursework (at least 3 units) Note: Diversity and Inclusion courses can also be used to meet the breadth category requirements, or major or minor requirements.",
      "contentHtml": "<p>All students must complete Diversity and Inclusion coursework (at least 3 units)</p><p><strong><em>Note: </em></strong>&nbsp;Diversity and Inclusion courses can also be used to meet the breadth category requirements, or major or minor requirements.</p>"
    },
    {
      "id": "184a72ef-5035-4d40-8e74-019452a0f1a0",
      "type": "GeneralTitle",
      "area": "General",
      "position": 10,
      "content": "Fundamental Skills",
      "contentHtml": null
    },
    {
      "id": "bd1987f2-b8c6-4cf3-b883-019452a0f1a1",
      "type": "GeneralText",
      "area": "General",
      "position": 11,
      "content": "Students must demonstrate competence in: Writing Quantitative Analysis (Math) Note: Failure to satisfy the fundamental skills requirements by the end of four semesters of full-time study at the University is grounds for academic disqualification.",
      "contentHtml": "<p>Students must demonstrate competence in:</p><p>Writing</p><p>Quantitative Analysis (Math)</p><p><strong><em>Note: </em></strong>&nbsp;Failure to satisfy the fundamental skills requirements by the end of four semesters of full-time study at the University is grounds for academic disqualification.</p>"
    },
    {
      "id": "9d30e4c0-332a-4931-8be2-019452a159bb",
      "type": "GeneralTitle",
      "area": "General",
      "position": 12,
      "content": "College of the Pacific BA Requirement",
      "contentHtml": null
    },
    {
      "id": "d8cbce97-f5de-4b78-8727-019452a159bb",
      "type": "GeneralText",
      "area": "General",
      "position": 13,
      "content": "Students must complete one year of college instruction or equivalent training in a language other than English. Note: Transfer students with sophomore standing are exempt from this requirement.",
      "contentHtml": "<p>Students must complete one year of college instruction or equivalent training in a language other than English.</p><p><strong><em>Note:</em></strong><em>&nbsp;&nbsp;Transfer students with sophomore standing are exempt from this requirement.</em></p>"
    }
  ],
