  "notes": [
    {
      "id": "c5bd3c83-5770-4ac4-98d4-01944cc6a2ee",
      "type": "GeneralTitle",
      "area": "General",
      "position": 0,
      "content": "Bachelor of Arts Major in English and Writing Professions",
      "contentHtml": null
    },
    {
      "id": "cb2b339a-0a05-4b56-8c9c-01944cc6a2ee",
      "type": "GeneralText",
      "area": "General",
      "position": 1,
      "content": "In order to earn the Bachelor of Arts degree with a major in English and Writing Professions, students must complete a minimum of 120 units with a Pacific cumulative and major/program grade point average of 2.0.",
      "contentHtml": "<p><span style=\"font-size: 16px;\">In order to earn the Bachelor of Arts degree with a major in English and Writing Professions, students must complete a minimum of 120 units with a Pacific cumulative and major/program grade point average of 2.0.</span></p>"
    },
    {
      "id": "6a11fdb9-5673-478f-ba79-01944ce07ffc",
      "type": "GeneralTitle",
      "area": "General",
      "position": 2,
      "content": "General Education Requirements",
      "contentHtml": null
    },
    {
      "id": "1e94e80f-f99f-48d8-841f-01944ce07ffd",
      "type": "GeneralText",
      "area": "General",
      "position": 3,
      "content": "For more details, see General Education Minimum 28 units and 9 courses that include:",
      "contentHtml": "<p>For more details, see&nbsp;<a href=\"https://catalog.pacific.edu/stocktongeneral/generaleducationprogram/\" rel=\"noopener noreferrer\" target=\"_blank\">General Education</a></p><p>Minimum 28 units and 9 courses that include:</p>"
    },
    {
      "id": "7a544568-9d0b-46be-892d-01944ce0f431",
      "type": "GeneralTitle",
      "area": "General",
      "position": 4,
      "content": "CORE Seminars (2 courses)",
      "contentHtml": null
    },
    {
      "id": "92c6b4af-3cc7-454d-9cba-01944ce0f431",
      "type": "GeneralText",
      "area": "General",
      "position": 5,
      "content": "Note: CORE Seminars cannot be taken for Pass/No Credit. 2) Transfer students with 28 or more transfer credits taken after high school are exempt from both CORE seminars.",
      "contentHtml": "<p><strong style=\"font-size: 16px;\"><em>Note: </em></strong><span style=\"font-size: 16px;\">CORE Seminars cannot be taken for Pass/No Credit.&nbsp;</span><strong style=\"font-size: 16px;\"><em>2)</em></strong><span style=\"font-size: 16px;\">&nbsp;Transfer students with 28 or more transfer credits taken after high school are exempt from both CORE seminars.&nbsp;&nbsp;</span></p>"
    },
    {
      "id": "3c884ae4-8ef3-4846-aab4-01944ce26fec",
      "type": "GeneralTitle",
      "area": "General",
      "position": 6,
      "content": "Breadth Requirement (7 courses, at least 3 units each)",
      "contentHtml": null
    },
    {
      "id": "985d5f44-ab6a-4552-84fd-01944ce26fec",
      "type": "GeneralText",
      "area": "General",
      "position": 7,
      "content": "Notes: 1) No more than 2 courses from a single discipline can be used to meet the Breadth Requirement. 2) Students must complete 60 units outside the primary discipline of the first major, regardless of the department who offers the course(s) in that discipline. (This includes general education courses, transfer courses, CPCE/EXTN units, internships, etc.)",
      "contentHtml": "<p><strong style=\"font-size: 16px;\"><em>Notes: </em></strong></p><p><strong style=\"font-size: 16px;\"><em>1)</em></strong><span style=\"font-size: 16px;\">&nbsp;No more than 2 courses from a single discipline can be used to meet the Breadth Requirement.</span></p><p><strong style=\"font-size: 16px;\"><em>2) </em></strong><span style=\"font-size: 16px;\">Students must complete 60 units outside the primary discipline of the first major, regardless of the department who offers the course(s) in that discipline. (This includes general education courses, transfer courses, CPCE/EXTN units, internships, etc.)</span></p>"
    },
    {
      "id": "99cb12d7-955a-4160-995e-01944ce2cbfb",
      "type": "GeneralTitle",
      "area": "General",
      "position": 8,
      "content": "Diversity and Inclusion Requirement",
      "contentHtml": null
    },
    {
      "id": "379a4631-8420-4f71-90b7-01944ce2cbfb",
      "type": "GeneralText",
      "area": "General",
      "position": 9,
      "content": "All students must complete Diversity and Inclusion coursework (at least 3 units) Note: Diversity and Inclusion courses can also be used to meet the breadth category requirements, or major or minor requirements.",
      "contentHtml": "<p>All students must complete Diversity and Inclusion coursework (at least 3 units)</p><p><strong><em>Note: </em></strong>Diversity and Inclusion courses can also be used to meet the breadth category requirements, or major or minor requirements.</p>"
    },
    {
      "id": "552cff1c-c740-4eeb-b034-01944ce3cd0e",
      "type": "GeneralTitle",
      "area": "General",
      "position": 10,
      "content": "Fundamental Skills",
      "contentHtml": null
    },
    {
      "id": "8523045d-e8f1-4108-bc42-01944ce3cd0f",
      "type": "GeneralText",
      "area": "General",
      "position": 11,
      "content": "Students must demonstrate competence in: Writing Quantitative Analysis (Math) Note: Failure to satisfy the fundamental skills requirements by the end of four semesters of full-time study at the University is grounds for academic disqualification.",
      "contentHtml": "<p>Students must demonstrate competence in:</p><p>Writing</p><p>Quantitative Analysis (Math)</p><p><strong><em>Note: </em></strong>&nbsp;Failure to satisfy the fundamental skills requirements by the end of four semesters of full-time study at the University is grounds for academic disqualification.</p>"
    },
    {
      "id": "9b2eca6b-d787-4768-918d-01944ce3cd0f",
      "type": "GeneralTitle",
      "area": "General",
      "position": 12,
      "content": "College of the Pacific BA Requirement",
      "contentHtml": null
    },
    {
      "id": "1d78c7d2-5ff9-43c0-800e-01944ce3cd0f",
      "type": "GeneralText",
      "area": "General",
      "position": 13,
      "content": "Students must complete one year of college instruction or equivalent training in a language other than English. Note: Transfer students with sophomore standing are exempt from this requirement.",
      "contentHtml": "<p>Students must complete one year of college instruction or equivalent training in a language other than English.</p><p><strong><em>Note:</em></strong><em>&nbsp;Transfer students with sophomore standing are exempt from this requirement.</em></p>"
