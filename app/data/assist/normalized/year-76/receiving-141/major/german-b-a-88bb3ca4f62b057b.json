    },
    {
      "id": "dcd26f45-6887-ef11-8474-000d3a37e3b6",
      "type": "GeneralText",
      "area": "General",
      "position": 1,
      "content": "See the University Catalog for the full listing of degree requirements for this major. See the Admissions website for transfer admission requirements/information. See the International Education &amp; Global Engagement website for international transfer academic qualifications. See the Academic Advising Programs website for information on California Promise and Associate Degree for Transfer. See the University Catalog for Credit by Exam information (AP, IB, CLEP).",
      "contentHtml": "<ul><li><span style=\"font-size: 14px;\">See the </span><a href=\"https://catalog.csuchico.edu/archive/2025-2026/colleges-departments/college-humanities-fine-arts/languages-cultures/german-ba/#programrequirementstext\" rel=\"noopener noreferrer\" target=\"_blank\" style=\"font-size: 14px;\">University Catalog</a><span style=\"font-size: 14px;\"> for the full listing of degree requirements for this major.</span></li><li><span style=\"font-size: 14px;\">See the </span><a href=\"https://www.csuchico.edu/admissions/transfer/index.shtml\" rel=\"noopener noreferrer\" target=\"_blank\" style=\"font-size: 14px;\">Admissions </a><span style=\"font-size: 14px;\">website for transfer admission requirements/information.</span></li><li><span style=\"font-size: 14px;\">See the </span><a href=\"https://www.csuchico.edu/international/qualifications/\" rel=\"noopener noreferrer\" target=\"_blank\" style=\"font-size: 14px;\">International Education &amp; Global Engagement </a><span style=\"font-size: 14px;\">website for international transfer academic qualifications.</span></li><li><span style=\"font-size: 14px;\">See the </span><a href=\"https://www.csuchico.edu/aap/programs/index.shtml\" rel=\"noopener noreferrer\" target=\"_blank\" style=\"font-size: 14px;\">Academic Advising Programs</a><span style=\"font-size: 14px;\"> website for information on California Promise and Associate Degree for Transfer.</span></li><li><span style=\"font-size: 14px;\">See the </span><a href=\"https://catalog.csuchico.edu/archive/2025-2026/academic-standards-policies/course-credit-policies/#creditbyexternalexamtext\" rel=\"noopener noreferrer\" target=\"_blank\" style=\"font-size: 14px;\">University Catalog</a><span style=\"font-size: 14px;\"> for Credit by Exam information (AP, IB, CLEP).</span></li></ul>"
    },
    {
      "id": "e2d26f45-6887-ef11-8474-000d3a37e3b6",
      "type": "GeneralTitle",
      "area": "General",
      "position": 2,
      "content": "Lower Division Major Requirements",
      "contentHtml": null
    },
    {
      "id": "d5d26f45-6887-ef11-8474-000d3a37e3b6",
      "type": "GeneralText",
      "area": "General",
      "position": 3,
      "content": "All courses listed within the major requirements are at the upper division level. See the University Catalog for a full listing of degree requirements. Only upper division German courses count toward the German major. The prerequisite for all upper division German courses is GERM 202 (Fourth Semester German) or its equivalent language competence. Students with little or no previous language preparation or competence must complete some or all of the language competence prerequisite courses listed below. Some or all of these courses may be waived by the Department through demonstrated language competence or high school or community college study. Students with one year of high school German should enroll in GERM 102 . Students with two years of high school German should enroll in GERM 201 . Students with three years of high school German should enroll in GERM 202 . Please consult the Languages and Cultures Department for proper level of placement.",
      "contentHtml": "<ul><li><span style=\"font-size: 14px;\">All courses listed within the major requirements are at the upper division level. See the </span><a href=\"https://catalog.csuchico.edu/archive/2025-2026/colleges-departments/college-humanities-fine-arts/languages-cultures/german-ba/#programrequirementstext\" rel=\"noopener noreferrer\" target=\"_blank\" style=\"font-size: 14px;\">University Catalog</a><span style=\"font-size: 14px;\"> for a full listing of degree requirements.</span></li><li><span style=\"font-size: 14px;\">Only upper division German courses count toward the German major.</span></li></ul><ol><li class=\"ql-indent-2\"><span style=\"font-size: 14px;\">The prerequisite for all upper division German courses is </span><strong style=\"font-size: 14px;\">GERM 202 </strong><span style=\"font-size: 14px;\">(Fourth Semester German) or its equivalent language competence.</span></li></ol><ul><li><span style=\"font-size: 14px;\">Students with little or no previous language preparation or competence must complete some or all of the </span><strong style=\"font-size: 14px;\">language competence prerequisite</strong><span style=\"font-size: 14px;\"> courses listed below.</span></li><li><span style=\"font-size: 14px;\">Some or all of these courses may be waived by the Department through demonstrated language competence or high school or community college study.</span></li></ul><ol><li class=\"ql-indent-2\"><span style=\"font-size: 14px;\">Students with one year of high school German should enroll in </span><strong style=\"font-size: 14px;\">GERM 102</strong><span style=\"font-size: 14px;\">.</span></li><li class=\"ql-indent-2\"><span style=\"font-size: 14px;\">Students with two years of high school German should enroll in </span><strong style=\"font-size: 14px;\">GERM 201</strong><span style=\"font-size: 14px;\">.</span></li><li class=\"ql-indent-2\"><span style=\"font-size: 14px;\">Students with three years of high school German should enroll in </span><strong style=\"font-size: 14px;\">GERM 202</strong><span style=\"font-size: 14px;\">.</span></li></ol><ul><li><span style=\"font-size: 14px;\">Please consult the Languages and Cultures Department for proper level of placement.</span></li></ul>"
