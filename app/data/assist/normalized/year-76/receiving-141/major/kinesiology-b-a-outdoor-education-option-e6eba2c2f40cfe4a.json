    },
    {
      "id": "28de6f45-6887-ef11-8474-000d3a37e3b6",
      "type": "GeneralText",
      "area": "General",
      "position": 3,
      "content": "Admission to the Outdoor Education Option is currently suspended. Please contact the Kinesiology Department for more information.",
      "contentHtml": "<p><span style=\"font-size: 14px;\">Admission to the Outdoor Education Option is currently suspended. Please contact the </span><a href=\"https://www.csuchico.edu/academics/college/communication-education/departments/kinesiology/\" rel=\"noopener noreferrer\" target=\"_blank\" style=\"font-size: 14px;\">Kinesiology Department</a><span style=\"font-size: 14px;\"> for more information.</span></p>"
    },
    {
      "id": "31de6f45-6887-ef11-8474-000d3a37e3b6",
      "type": "GeneralTitle",
      "area": "General",
      "position": 4,
      "content": "Computer Literacy Requirement",
      "contentHtml": null
    },
    {
      "id": "2ede6f45-6887-ef11-8474-000d3a37e3b6",
      "type": "GeneralText",
      "area": "General",
      "position": 5,
      "content": "Basic computer literacy skills are required and may be met through select college courses (e.g. UNIV 101 or its transfer equivalents) or through prior experience.",
      "contentHtml": "<p><span style=\"font-size: 14px;\">Basic computer literacy skills are required and may be met through select college courses (e.g. </span><strong style=\"font-size: 14px;\">UNIV 101</strong><span style=\"font-size: 14px;\"> or its transfer equivalents) or through prior experience.</span></p>"
    },
    {
