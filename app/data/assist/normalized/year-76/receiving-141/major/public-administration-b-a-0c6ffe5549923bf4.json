    {
      "id": "76adb24d-c4b7-43e1-b1ee-019719118367",
      "type": "GeneralText",
      "area": "General",
      "position": 7,
      "content": "The online Bachelor of Arts in Public Administration at Chico State prepares students for rewarding careers in government, nonprofit organizations, and public service. Our flexible online format allows students to balance their education with work and personal commitments, making it ideal for both traditional students and working professionals seeking career advancement.",
      "contentHtml": "<p><span style=\"font-size: 14px;\">The online Bachelor of Arts in Public Administration at Chico State prepares students for rewarding careers in government, nonprofit organizations, and public service. Our flexible online format allows students to balance their education with work and personal commitments, making it ideal for both traditional students and working professionals seeking career advancement.</span></p>"
    },
