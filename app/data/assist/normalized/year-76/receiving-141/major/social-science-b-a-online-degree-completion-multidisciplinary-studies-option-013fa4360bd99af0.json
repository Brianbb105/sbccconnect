  "notes": [
    {
      "id": "cbb36845-6887-ef11-8474-000d3a37e3b6",
      "type": "GeneralTitle",
      "area": "General",
      "position": 0,
      "content": "RESOURCES",
      "contentHtml": null
    },
    {
      "id": "cab36845-6887-ef11-8474-000d3a37e3b6",
      "type": "GeneralText",
      "area": "General",
      "position": 1,
      "content": "See the Professional &amp; Continuing Education website for more information about this program and to start the application process. See the University Catalog for prerequisite information and upper division program requirements . See the Admissions website for transfer admission requirements/information. See the International Education &amp; Global Engagement website for international transfer academic qualifications. See the Academic Advising Programs website for information on California Promise and Associate Degree for Transfer. See the University Catalog for Credit by Exam information (AP, IB, CLEP). Online degree completion students who have completed their General Education and American Ideals/Institutions requirements before transferring to Chico State and who enroll in classes full time can easily finish their BA in social science in two years. Note that some online courses are offered only once a year, so careful planning is crucial. All students must meet with a Social Science advisor each semester for mandatory advising.",
      "contentHtml": "<ul><li><span style=\"font-size: 14px;\">See the </span><a href=\"https://rce.csuchico.edu/social-science\" rel=\"noopener noreferrer\" target=\"_blank\" style=\"font-size: 14px;\">Professional &amp; Continuing Education</a><span style=\"font-size: 14px;\"> website for more information about this program and to start the application process.</span></li><li><span style=\"font-size: 14px;\">See the University Catalog for </span><a href=\"https://catalog.csuchico.edu/archive/2025-2026/colleges-departments/college-behavioral-social-sciences/social-science/social-science-online-ba/#admissiontransfertext\" rel=\"noopener noreferrer\" target=\"_blank\" style=\"font-size: 14px;\">prerequisite information</a><span style=\"font-size: 14px;\"> and </span><a href=\"https://catalog.csuchico.edu/archive/2025-2026/colleges-departments/college-behavioral-social-sciences/social-science/social-science-online-ba/#programrequirementstext\" rel=\"noopener noreferrer\" target=\"_blank\" style=\"font-size: 14px;\">upper division program requirements</a><span style=\"font-size: 14px;\">.</span></li><li><span style=\"font-size: 14px;\">See the </span><a href=\"https://www.csuchico.edu/admissions/transfer/index.shtml\" rel=\"noopener noreferrer\" target=\"_blank\" style=\"font-size: 14px;\">Admissions</a><span style=\"font-size: 14px;\"> website for transfer admission requirements/information.</span></li><li><span style=\"font-size: 14px;\">See the </span><a href=\"https://www.csuchico.edu/international/qualifications/\" rel=\"noopener noreferrer\" target=\"_blank\" style=\"font-size: 14px;\">International Education &amp; Global Engagement</a><span style=\"font-size: 14px;\"> website for international transfer academic qualifications.</span></li><li><span style=\"font-size: 14px;\">See the</span><a href=\"https://www.csuchico.edu/aap/programs/index.shtml\" rel=\"noopener noreferrer\" target=\"_blank\" style=\"font-size: 14px;\"> Academic Advising Programs</a><span style=\"font-size: 14px;\"> website for information on California Promise and Associate Degree for Transfer.</span></li><li><span style=\"font-size: 14px;\">See the </span><a href=\"https://catalog.csuchico.edu/archive/2025-2026/academic-standards-policies/course-credit-policies/#creditbyexternalexamtext\" rel=\"noopener noreferrer\" target=\"_blank\" style=\"font-size: 14px;\">University Catalog</a><span style=\"font-size: 14px;\"> for Credit by Exam information (AP, IB, CLEP).</span></li></ul><p><br></p><p><span style=\"font-size: 14px;\">Online degree completion students who have completed their General Education and American Ideals/Institutions requirements before transferring to Chico State and who enroll in classes full time can easily finish their BA in social science in two years. Note that some online courses are offered only once a year, so careful planning is crucial. All students must meet with a Social Science advisor each semester for mandatory advising.</span></p>"
    },
    {
      "id": "d1b36845-6887-ef11-8474-000d3a37e3b6",
      "type": "GeneralTitle",
      "area": "General",
      "position": 2,
      "content": "UPPER DIVISION NOTE",
      "contentHtml": null
    },
    {
      "id": "d4b36845-6887-ef11-8474-000d3a37e3b6",
      "type": "GeneralText",
      "area": "General",
      "position": 3,
      "content": "In sections below where the student is directed to select courses and there is a note \"Only lower division courses listed,\" upper division courses are also available. See the University Catalog for the full listing of degree requirements.",
      "contentHtml": "<p><span style=\"font-size: 14px;\">In sections below where the student is directed to select courses and there is a note \"Only lower division courses listed,\" upper division courses are also available. See the </span><a href=\"https://catalog.csuchico.edu/archive/2025-2026/colleges-departments/college-behavioral-social-sciences/social-science/social-science-online-ba/#multidisciplinarystudies\" rel=\"noopener noreferrer\" target=\"_blank\" style=\"font-size: 14px;\">University Catalog</a><span style=\"font-size: 14px;\"> for the full listing of degree requirements.</span></p>"
    },
    {
      "id": "2e52bfb7-79cd-4d14-a731-01975fec8307",
      "type": "GeneralTitle",
      "area": "General",
      "position": 4,
      "content": "Important Note",
      "contentHtml": null
    },
    {
      "id": "0520010d-d155-413f-84f8-019755ce93ba",
      "type": "GeneralText",
      "area": "General",
      "position": 5,
      "content": "This agreement is not a static document. Articulations may be updated or added at any time , and the information provided is subject to change without notice. This agreement does not include upper-division major requirements, course prerequisites, general education coursework, or university-specific graduation requirements necessary for degree completion. Department agreements should be referenced alongside major agreements to ensure a clearer understanding of course articulation and program planning.",
      "contentHtml": "<p><span style=\"font-size: 14px;\">This agreement is not a static document. </span><strong style=\"font-size: 14px;\">Articulations may be updated or added at any time</strong><span style=\"font-size: 14px;\">, and the information provided is subject to change without notice.</span></p><p><br></p><p><span style=\"font-size: 14px;\">This agreement does not include upper-division major requirements, course prerequisites, general education coursework, or university-specific graduation requirements necessary for degree completion.</span></p><p><br></p><p><span style=\"font-size: 14px;\">Department agreements should be referenced alongside major agreements to ensure a clearer understanding of course articulation and program planning.</span></p>"
