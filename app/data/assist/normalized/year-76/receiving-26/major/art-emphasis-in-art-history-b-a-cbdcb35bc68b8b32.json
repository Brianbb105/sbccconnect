  "notes": [
    {
      "id": "dbf47845-6887-ef11-8474-000d3a37e3b6",
      "type": "GeneralText",
      "area": "General",
      "position": 0,
      "content": "Due to high demand, admission to SDSU is highly competitive. General admission information is available at: http://arweb.sdsu.edu/es/admissions/transfers/index.html",
      "contentHtml": "<p>Due to high demand, admission to SDSU is highly competitive. General admission information is available at:<a href=\"http://arweb.sdsu.edu/es/admissions/transfers/index.html\" rel=\"noopener noreferrer\" target=\"_blank\">http://arweb.sdsu.edu/es/admissions/transfers/index.html</a> </p>"
    },
    {
      "id": "3ab97645-6887-ef11-8474-000d3a37e3b6",
      "type": "GeneralTitle",
      "area": "General",
      "position": 1,
      "content": "Foreign Language (3 semesters)",
      "contentHtml": null
    },
    {
      "id": "f2ec7145-6887-ef11-8474-000d3a37e3b6",
      "type": "GeneralText",
      "area": "General",
      "position": 2,
      "content": "Competency (successfully completing the third college semester or fifth college quarter) is required in one foreign language to fulfill graduation requirements for this major. French or German is recommended for those students who plan to pursue graduate study in art history.",
      "contentHtml": "Competency (successfully completing the third college semester or fifth college quarter) is required in one foreign language to fulfill graduation requirements for this major. French or German is recommended for those students who plan to pursue graduate study in art history."
    },
    {
      "id": "b4e87c90-5529-4e55-ac61-0192b0c9224c",
      "type": "GeneralText",
      "area": "General",
      "position": 3,
      "content": "Students completing the California Community College Associate in Arts in Art History for Transfer (AA-T) will satisfy preparation for the major. If ART 101 was not completed as part of the AA-T, it must be completed at SDSU.",
      "contentHtml": "<p><span style=\"font-size: 16px;\">Students completing the California Community College Associate in Arts in Art History for Transfer (AA-T) will satisfy preparation for the major. If&nbsp;</span><a href=\"https://catalog.sdsu.edu/preview_program.php?catoid=10&amp;poid=9882&amp;returnto=909#tt439\" rel=\"noopener noreferrer\" target=\"_blank\" style=\"font-size: 16px;\">ART 101</a><span style=\"font-size: 16px;\">&nbsp;was not completed as part of the AA-T, it must be completed at SDSU.</span></p>"
    },
    {
      "id": "e6ec3405-bb61-4418-a1f0-0199aadf30c9",
      "type": "GeneralText",
      "area": "General",
      "position": 4,
      "content": "Courses in the major may not be taken for credit/nocredit (Cr/NC). Major courses must be completed with a grade of C or better.",
      "contentHtml": "<p>Courses in the major may not be taken for credit/nocredit (Cr/NC).  Major courses must be completed with a grade of C or better.</p>"
    }
  ],
