    {
      "id": "bab25d59-1692-4462-989e-01979d7ba845",
      "type": "GeneralText",
      "area": "General",
      "position": 1,
      "content": "Students graduating from Sacramento State are required to complete a second semester composition course. Second semester composition courses (ENGL 20, ENGL 20M, or an approved equivalent) must be completed with a grade of C- or better. Although not required for admission, transfer students are encouraged to complete a course fulfilling this requirement prior to transfer. Please see a counselor for more information.",
      "contentHtml": "<p><span style=\"font-size: 14px;\">Students graduating from Sacramento State are required to complete a second semester composition course. Second semester composition courses (ENGL 20, ENGL 20M, or an approved equivalent) must be completed with a grade of C- or better.</span></p><p><br></p><p><span style=\"font-size: 14px;\">Although not required for admission, transfer students are encouraged to complete a course fulfilling this requirement prior to transfer. Please see a counselor for more information.</span></p>"
    }
