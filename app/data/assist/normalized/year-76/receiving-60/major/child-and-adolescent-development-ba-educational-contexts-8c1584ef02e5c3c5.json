  "notes": [
    {
      "id": "007a6f45-6887-ef11-8474-000d3a37e3b6",
      "type": "GeneralTitle",
      "area": "General",
      "position": 0,
      "content": "TRANSFER INFORMATION",
      "contentHtml": null
    },
    {
      "id": "c5f00eca-cbc8-47ad-8460-01928cbe4ef3",
      "type": "GeneralText",
      "area": "General",
      "position": 1,
      "content": "Thank you for your interest in Sacramento State! This articulation agreement displays the lower-division courses required in the major: Sacramento State course son the left and approved (articulated) transfer courses on the right. Any upper-division courses included in this agreement will receive lower-division subject credit only. Although completion of the coursework listed below is not mandatory prior to admission, students are advised to complete as much lower-division course preparation as possible prior to transfer. Additional Resources: See the University Catalog for the full listing of degree requirements for this major. Visit our Sac State Apply page for more information about our campus! Visit the Admissions website for current transfer admission requirements. Connect with an Admissions Counselor .",
      "contentHtml": "<p><strong style=\"font-size: 14px;\">Thank you for your interest in Sacramento State! </strong></p><p><br></p><p><span style=\"font-size: 14px;\">This articulation agreement displays the lower-division courses required in the major: Sacramento State course son the left and approved (articulated) transfer courses on the right. Any upper-division courses included in this agreement will receive lower-division subject credit only. Although completion of the coursework listed below is not mandatory prior to admission, students are advised to complete as much lower-division course preparation as possible prior to transfer.</span></p><p><br></p><p><span style=\"font-size: 14px;\">Additional Resources: </span></p><ul><li><span style=\"font-size: 14px;\">See the </span><a href=\"https://catalog.csus.edu/\" rel=\"noopener noreferrer\" target=\"_blank\" style=\"font-size: 14px; color: rgb(41, 98, 255);\"><strong><u>University Catalog</u></strong></a><span style=\"font-size: 14px;\"> for the full listing of degree requirements for this major.</span></li><li><span style=\"font-size: 14px;\">Visit our </span><a href=\"https://www.csus.edu/apply/\" rel=\"noopener noreferrer\" target=\"_blank\" style=\"font-size: 14px; color: rgb(41, 98, 255);\"><strong><u>Sac State Apply</u></strong></a><span style=\"font-size: 14px;\"> page for more information about our campus! </span></li><li><span style=\"font-size: 14px;\">Visit the </span><a href=\"https://www.csus.edu/apply/admissions/application-process/\" rel=\"noopener noreferrer\" target=\"_blank\" style=\"font-size: 14px; color: rgb(41, 98, 255);\"><strong><u>Admissions website</u></strong></a><span style=\"font-size: 14px;\"> for current transfer admission requirements.</span></li><li><span style=\"font-size: 14px;\">Connect with an </span><a href=\"https://www.csus.edu/apply/admissions/connect-with-admissions.html\" rel=\"noopener noreferrer\" target=\"_blank\" style=\"font-size: 14px; color: rgb(41, 98, 255);\"><strong><u>Admissions Counselor</u></strong></a><span style=\"font-size: 14px;\">.</span></li></ul>"
    },
    {
      "id": "0c7a6f45-6887-ef11-8474-000d3a37e3b6",
      "type": "GeneralTitle",
      "area": "General",
      "position": 2,
      "content": "MAJOR INFORMATION",
      "contentHtml": null
    },
    {
      "id": "0e7a6f45-6887-ef11-8474-000d3a37e3b6",
      "type": "GeneralText",
      "area": "General",
      "position": 3,
      "content": "Students must earn a \"C-\" grade or higher in all courses required in the major. The Associate Degree for Transfer (ADT) in Child and Adolescent Development and the Associate Degree for Transfer (ADT) in Early Childhood Education are compatible with the B.A. in Child and Adolescent Development - Educational Contexts concentration at Sacramento State. Students pursuing the Associate Degree for Transfer must complete all lower-division major coursework with a \"C\" or better. For Child and Adolescent Development advising, please contact the department at (916) 278-6639. For additional information, please visit: Child and Adolescent Development .",
      "contentHtml": "<ol><li><span style=\"font-size: 14px;\">Students must earn a \"C-\" grade or higher in all courses required in the major.</span></li><li><span style=\"font-size: 14px;\">The Associate Degree for Transfer (ADT) in Child and Adolescent Development and the Associate Degree for Transfer (ADT) in Early Childhood Education are compatible with the B.A. in Child and Adolescent Development - Educational Contexts concentration at Sacramento State. Students pursuing the Associate Degree for Transfer must complete all lower-division major coursework with a \"C\" or better.</span></li><li><span style=\"font-size: 14px;\">For Child and Adolescent Development advising, please contact the department at (916) 278-6639.</span></li><li><span style=\"font-size: 14px;\">For additional information, please visit: </span><a href=\"https://www.csus.edu/college/education/undergraduate/child-adolescent-development.html\" rel=\"noopener noreferrer\" target=\"_blank\" style=\"font-size: 14px; color: rgb(41, 98, 255);\"><strong>Child and Adolescent Development</strong></a><span style=\"font-size: 14px;\">.</span></li></ol>"
    }
  ],
