    {
      "id": "df7b6f45-6887-ef11-8474-000d3a37e3b6",
      "type": "GeneralText",
      "area": "General",
      "position": 1,
      "content": "Thank you for your interest in Sacramento State! This articulation agreement displays the lower-division courses required in the major: Sacramento State courses on the left and approved (articulated) transfer courses on the right. Although completion of the coursework listed below is not mandatory prior to admission, students are advised to complete as much lower-division course preparation as possible prior to transfer. Additional Resources: See the University Catalog for the full listing of degree requirements for this major. Visit our Sac State Apply page for more information about our campus! Visit the Admissions website for current transfer admission requirements. Connect with an Admissions Counselor .",
      "contentHtml": "<p><strong style=\"color: rgb(29, 32, 36); font-size: 14px;\">Thank you for your interest in Sacramento State! </strong></p><p><br></p><p><span style=\"font-size: 14px;\">This articulation agreement displays the lower-division courses required in the major: Sacramento State courses on the left and approved (articulated) transfer courses on the right. Although completion of the coursework listed below is not mandatory prior to admission, students are advised to complete as much lower-division course preparation as possible prior to transfer. </span></p><p><br></p><p><span style=\"font-size: 14px;\">Additional Resources:</span></p><ul><li><span style=\"font-size: 14px;\">See the </span><a href=\"https://catalog.csus.edu/\" rel=\"noopener noreferrer\" target=\"_blank\" style=\"font-size: 14px; color: rgb(41, 98, 255);\"><strong>University Catalog</strong></a><span style=\"font-size: 14px;\"> for the full listing of degree requirements for this major.</span></li><li><span style=\"font-size: 14px;\">Visit our </span><a href=\"https://www.csus.edu/apply/\" rel=\"noopener noreferrer\" target=\"_blank\" style=\"font-size: 14px; color: rgb(41, 98, 255);\"><strong>Sac State Apply</strong></a><span style=\"font-size: 14px;\"> page for more information about our campus!</span></li><li><span style=\"font-size: 14px;\">Visit the </span><a href=\"https://www.csus.edu/apply/admissions/application-process/\" rel=\"noopener noreferrer\" target=\"_blank\" style=\"font-size: 14px; color: rgb(41, 98, 255);\"><strong>Admissions website</strong></a><span style=\"font-size: 14px;\"> for current transfer admission requirements. </span></li><li><span style=\"font-size: 14px;\">Connect with an </span><a href=\"https://www.csus.edu/apply/admissions/connect-with-admissions.html\" rel=\"noopener noreferrer\" target=\"_blank\" style=\"font-size: 14px; color: rgb(41, 98, 255);\"><strong>Admissions Counselor</strong></a><span style=\"font-size: 14px;\">. </span></li></ul>"
    },
    {
      "id": "09786f45-6887-ef11-8474-000d3a37e3b6",
      "type": "GeneralTitle",
      "area": "General",
      "position": 2,
      "content": "MAJOR INFORMATION",
      "contentHtml": null
    },
    {
      "id": "0d786f45-6887-ef11-8474-000d3a37e3b6",
      "type": "GeneralText",
      "area": "General",
      "position": 3,
      "content": "The Pre-Major is a total of 6 units: SOC 1, and one of the following: SOC 3, SOC 5, SOC 8, or SOC 10. The Associate Degree for Transfer (ADT) in Sociology is compatible with the B.A. in Sociology at Sacramento State. Students pursuing the Associate Degree for Transfer must complete all lower-division major coursework with a \"C\" grade or better. For additional information, please visit: Department of Sociology .",
      "contentHtml": "<ol><li><span style=\"font-size: 14px;\">The Pre-Major is a total of 6 units: SOC 1, and one of the following: SOC 3, SOC 5, SOC 8, or SOC 10.</span></li><li><span style=\"font-size: 14px;\">The Associate Degree for Transfer (ADT) in Sociology is compatible with the B.A. in Sociology at Sacramento State. Students pursuing the Associate Degree for Transfer must complete all lower-division major coursework with a \"C\" grade or better. </span></li><li><span style=\"font-size: 14px;\">For additional information, please visit: </span><a href=\"https://www.csus.edu/college/social-sciences-interdisciplinary-studies/sociology/\" rel=\"noopener noreferrer\" target=\"_blank\" style=\"font-size: 14px; color: rgb(41, 98, 255);\"><strong>Department of Sociology</strong></a><span style=\"font-size: 14px;\">.</span></li></ol>"
    }
