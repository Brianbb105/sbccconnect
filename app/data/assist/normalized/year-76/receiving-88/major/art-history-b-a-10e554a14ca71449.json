    {
      "id": "e1cf7645-6887-ef11-8474-000d3a37e3b6",
      "type": "GeneralTitle",
      "area": "General",
      "position": 2,
      "content": "GENERAL information",
      "contentHtml": null
    },
    {
      "id": "d2ed7145-6887-ef11-8474-000d3a37e3b6",
      "type": "GeneralText",
      "area": "General",
      "position": 3,
      "content": "This agreement is subject to revision without prior notice. Please check with a counselor every semester to obtain current information about possible changes in the agreement. To learn more about the courses and programs offered at Sonoma State University or the General Education and Upper-division requirements for each major please refer to the university catalog at: http://www.sonoma.edu/catalog/",
      "contentHtml": "This agreement is subject to revision without prior notice.  Please check with a counselor every semester to obtain current information about possible changes in the agreement.  To learn more about the courses and programs offered at Sonoma State University or the General Education and Upper-division requirements for each major please refer to the university catalog at: <a href=\"http://www.sonoma.edu/catalog/\" target=\"_blank\">http://www.sonoma.edu/catalog/</a>"
    },
    {
      "id": "cff67645-6887-ef11-8474-000d3a37e3b6",
      "type": "GeneralTitle",
      "area": "General",
      "position": 4,
      "content": "Associate degree for transfer information",
      "contentHtml": null
    },
    {
      "id": "e8087745-6887-ef11-8474-000d3a37e3b6",
      "type": "GeneralText",
      "area": "General",
      "position": 5,
      "content": "The AA-T in Art History (SB 1440 degree) has been deemed as a &quot;similar&quot; degree to the Art History, B.A. at Sonoma State. Students transfering to SSU with an AA-T in Art History are advised to complete all available articulated major requirement and support courses before transfer. It is also recommended that students complete the American Instutitions (US-1, US-2, US-3), and Seawolf Studies Graduation requirements before transfer.",
      "contentHtml": "The AA-T in Art History (SB 1440 degree) has been deemed as a &quot;similar&quot; degree to the Art History, B.A. at Sonoma State.  Students transfering to SSU with an AA-T in Art History are advised to complete all available articulated major requirement and support courses before transfer.  It is also recommended that students complete the American Instutitions (US-1, US-2, US-3), and Seawolf Studies Graduation requirements before transfer."
    },
    {
      "id": "8cc27645-6887-ef11-8474-000d3a37e3b6",
      "type": "GeneralTitle",
      "area": "General",
      "position": 6,
      "content": "Art History, B.A.",
      "contentHtml": null
    },
    {
      "id": "07fe7645-6887-ef11-8474-000d3a37e3b6",
      "type": "GeneralText",
      "area": "General",
      "position": 7,
      "content": "Note: Reading comprehension of at least one foreign language is essential for Art History majors. Students are advised to develop competence in French, German, Italian, and/or Spanish; however, the prospect of eventual specialization may make other languages advisable in particular instances. *Studio/Language Courses Section Below: In addition, one course in drawing, a beginning course in any medium or any language course.",
      "contentHtml": "<p>Note: Reading comprehension of at least one foreign language is essential for Art History majors. Students are advised to develop competence in French, German, Italian, and/or Spanish; however, the prospect of eventual specialization may make other languages advisable in particular instances. </p><p><br></p><p>*Studio/Language Courses Section Below: In addition, one course in drawing, a beginning course in any medium or any language course.</p>"
    }
