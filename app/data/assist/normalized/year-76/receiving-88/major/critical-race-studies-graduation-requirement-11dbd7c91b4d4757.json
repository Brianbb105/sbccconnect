    {
      "id": "d2ed7145-6887-ef11-8474-000d3a37e3b6",
      "type": "GeneralText",
      "area": "General",
      "position": 1,
      "content": "This agreement is subject to revision without prior notice. Please check with a counselor every semester to obtain current information about possible changes in the agreement. To learn more about the courses and programs offered at Sonoma State University or the General Education and Upper-division requirements for each major please refer to the university catalog at: http://www.sonoma.edu/catalog/",
      "contentHtml": "This agreement is subject to revision without prior notice.  Please check with a counselor every semester to obtain current information about possible changes in the agreement.  To learn more about the courses and programs offered at Sonoma State University or the General Education and Upper-division requirements for each major please refer to the university catalog at: <a href=\"http://www.sonoma.edu/catalog/\" target=\"_blank\">http://www.sonoma.edu/catalog/</a>"
    },
    {
      "id": "c1fa7645-6887-ef11-8474-000d3a37e3b6",
      "type": "GeneralTitle",
      "area": "General",
      "position": 2,
      "content": "Critical race studies graduation requirement",
      "contentHtml": null
    },
    {
      "id": "6c727445-6887-ef11-8474-000d3a37e3b6",
      "type": "GeneralText",
      "area": "General",
      "position": 3,
      "content": "The courses on the list below will fulfill the Critical Race Studies Graduation requirement at Sonoma State University not GE area F. The requirement can only be met with the approved courses on this list or courses that are approved for GE area F. Not all courses on this list are approved for GE area F. Please consult a counselor on your campus or the CSU GE-Breadth Certification Courses for GE area F for your specific campus at ASSIST.org.",
      "contentHtml": "<p>The courses on the list below will fulfill the Critical Race Studies Graduation requirement at Sonoma State University not GE area F. The requirement can only be met with the approved courses on this list or courses that are approved for GE area F. Not all courses on this list are approved for GE area F. Please consult a counselor on your campus or the CSU GE-Breadth Certification Courses for GE area F for your specific campus at ASSIST.org.</p>"
    }
