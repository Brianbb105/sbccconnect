      "contentHtml": null
    },
    {
      "id": "dfa1e606-bce4-4663-bfdd-019832da5715",
      "type": "GeneralText",
      "area": "General",
      "position": 1,
      "content": "Please be advised that this major is currently being discontinued and may not be available upon transfer. Please visit academicaffairs.sonoma.edu/academic-programs for the most recent information.",
      "contentHtml": "<p><strong style=\"color: rgb(169, 62, 58); font-size: 16px;\">Please be advised that this major is currently being discontinued and may not be available upon transfer. Please visit</strong><strong style=\"font-size: 16px;\"> </strong><a href=\"http://academicaffairs.sonoma.edu/academic-programs\" rel=\"noopener noreferrer\" target=\"_blank\" style=\"font-size: 16px;\"><strong>academicaffairs.sonoma.edu/academic-programs</strong></a><strong style=\"font-size: 16px;\"> </strong><strong style=\"color: rgb(169, 62, 58); font-size: 16px;\">for the most recent information.</strong></p><p><br></p><p><br></p><p><br></p>"
    },
    {
      "id": "1b3e7445-6887-ef11-8474-000d3a37e3b6",
      "type": "GeneralTitle",
      "area": "General",
      "position": 2,
      "content": "GENERAL information",
      "contentHtml": null
    },
    {
      "id": "d2ed7145-6887-ef11-8474-000d3a37e3b6",
      "type": "GeneralText",
      "area": "General",
      "position": 3,
      "content": "This agreement is subject to revision without prior notice. Please check with a counselor every semester to obtain current information about possible changes in the agreement. To learn more about the courses and programs offered at Sonoma State University or the General Education and Upper-division requirements for each major please refer to the university catalog at: http://www.sonoma.edu/catalog/",
      "contentHtml": "This agreement is subject to revision without prior notice.  Please check with a counselor every semester to obtain current information about possible changes in the agreement.  To learn more about the courses and programs offered at Sonoma State University or the General Education and Upper-division requirements for each major please refer to the university catalog at: <a href=\"http://www.sonoma.edu/catalog/\" target=\"_blank\">http://www.sonoma.edu/catalog/</a>"
    },
    {
      "id": "01ca7645-6887-ef11-8474-000d3a37e3b6",
      "type": "GeneralTitle",
      "area": "General",
      "position": 4,
      "content": "Associate degree for transfer information",
      "contentHtml": null
    },
    {
      "id": "0c917645-6887-ef11-8474-000d3a37e3b6",
      "type": "GeneralText",
      "area": "General",
      "position": 5,
      "content": "The AA-T in Economics (SB 1440 degree) has been deemed as \"similar\" degree to the Economics, B.A. at Sonoma State. Students transferring to SSU with an AA-T in Economics are advised to complete all available articulated major requirement and support courses before transfer. It is also recommended that students complete the American Institutions (US-1, US-2, US-3), and Seawolf Studies Graduation requirements before transfer.",
      "contentHtml": "<p>The AA-T in Economics (SB 1440 degree) has been deemed as \"similar\" degree to the Economics, B.A. at Sonoma State. Students transferring to SSU with an AA-T in Economics are advised to complete all available articulated major requirement and support courses before transfer. It is also recommended that students complete the American Institutions (US-1, US-2, US-3), and Seawolf Studies Graduation requirements before transfer.</p>"
    }
  ],
