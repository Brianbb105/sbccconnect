    {
      "id": "d2ed7145-6887-ef11-8474-000d3a37e3b6",
      "type": "GeneralText",
      "area": "General",
      "position": 1,
      "content": "This agreement is subject to revision without prior notice. Please check with a counselor every semester to obtain current information about possible changes in the agreement. To learn more about the courses and programs offered at Sonoma State University or the General Education and Upper-division requirements for each major please refer to the university catalog at: http://www.sonoma.edu/catalog/",
      "contentHtml": "This agreement is subject to revision without prior notice.  Please check with a counselor every semester to obtain current information about possible changes in the agreement.  To learn more about the courses and programs offered at Sonoma State University or the General Education and Upper-division requirements for each major please refer to the university catalog at: <a href=\"http://www.sonoma.edu/catalog/\" target=\"_blank\">http://www.sonoma.edu/catalog/</a>"
    },
    {
      "id": "16387445-6887-ef11-8474-000d3a37e3b6",
      "type": "GeneralTitle",
      "area": "General",
      "position": 2,
      "content": "important transfer information",
      "contentHtml": null
    },
    {
      "id": "09fe6f45-6887-ef11-8474-000d3a37e3b6",
      "type": "GeneralText",
      "area": "General",
      "position": 3,
      "content": "Students must earn a &quot;C&quot; or better in any course applied to the major.",
      "contentHtml": "Students must earn a &quot;C&quot; or better in any course applied to the major."
    },
    {
      "id": "77927645-6887-ef11-8474-000d3a37e3b6",
      "type": "GeneralTitle",
      "area": "General",
      "position": 4,
      "content": "Associate degree for transfer information",
      "contentHtml": null
    },
    {
      "id": "48e57145-6887-ef11-8474-000d3a37e3b6",
      "type": "GeneralText",
      "area": "General",
      "position": 5,
      "content": "The AA-T in Political Science (SB 1440 degree) has been deemed a \"similar\" degree to the Political Science, B.A. at Sonoma State. Students transferring to SSU with an AA-T in Political Science are advised to complete all available articulated major requirement and support courses before transfer. It is also recommended that students complete the American Institutions (US-1, US-2, US-3), and Seawolf Studies Graduation requirements before transfer.",
      "contentHtml": "<p>The AA-T in Political Science (SB 1440 degree) has been deemed a \"similar\" degree to the Political Science, B.A. at Sonoma State. Students transferring to SSU with an AA-T in Political Science are advised to complete all available articulated major requirement and support courses before transfer. It is also recommended that students complete the American Institutions (US-1, US-2, US-3), and Seawolf Studies Graduation requirements before transfer.</p>"
    }
