    },
    {
      "id": "97046645-6887-ef11-8474-000d3a37e3b6",
      "type": "GeneralText",
      "area": "General",
      "position": 1,
      "content": "This agreement displays all lower-division courses required in the major : Stanislaus State courses or requirements on the left, approved (articulated) transfer courses on the right. Helpful resources: Academic Catalog Transfer Admissions Questions regarding this agreement may be directed to the Stanislaus State Articulation Analyst. Please visit the Stanislaus State Articulation Website for contact information.",
      "contentHtml": "<p>This agreement displays all<strong> lower-division courses required in the major</strong>: Stanislaus State courses or requirements on the left, approved (articulated) transfer courses on the right.</p><p><br></p><p><strong>Helpful resources: </strong></p><p><a href=\"https://catalog.csustan.edu/index.php\" rel=\"noopener noreferrer\" target=\"_blank\">Academic Catalog</a></p><p><a href=\"https://www.csustan.edu/undergrad/transfer-admission\" rel=\"noopener noreferrer\" target=\"_blank\">Transfer Admissions</a></p><p><br></p><p>Questions regarding this agreement may be directed to the Stanislaus State Articulation Analyst. Please visit the <a href=\"https://www.csustan.edu/articulation\" rel=\"noopener noreferrer\" target=\"_blank\">Stanislaus State Articulation Website</a> for contact information.</p>"
    },
    {
      "id": "d92f7445-6887-ef11-8474-000d3a37e3b6",
      "type": "GeneralTitle",
      "area": "General",
      "position": 2,
      "content": "ABOUT THE MAJOR",
      "contentHtml": null
    },
    {
      "id": "e63c7445-6887-ef11-8474-000d3a37e3b6",
      "type": "GeneralText",
      "area": "General",
      "position": 3,
      "content": "Creative Media is an interdisciplinary Bachelor of Arts degree that unites expertise from a variety of disciplines to offer students the opportunity to develop their abilities in critical thinking and teamwork as they create compelling narratives across media platforms. This program draws from diverse fields including Art, Anthropology, Business, English, Ethnic Studies, Gender Studies, Journalism, Political Science, Spanish and Theatre to bring together knowledge and practical experience. Students will build a foundational core in preparation for exploring their own interests in advocacy, design, creative writing, media and film, visual storytelling or live performance.",
      "contentHtml": "<p>Creative Media is an interdisciplinary Bachelor of Arts degree that unites expertise from a variety of disciplines to offer students the opportunity to develop their abilities in critical thinking and teamwork as they create compelling narratives across media platforms. This program draws from diverse fields including Art, Anthropology, Business, English, Ethnic Studies, Gender Studies, Journalism, Political Science, Spanish and Theatre to bring together knowledge and practical experience. Students will build a foundational core in preparation for exploring their own interests in advocacy, design, creative writing, media and film, visual storytelling or live performance.</p>"
    },
    {
      "id": "41d67645-6887-ef11-8474-000d3a37e3b6",
      "type": "GeneralTitle",
      "area": "General",
      "position": 4,
      "content": "ABOUT LOWER DIVISION MAJOR REQUIREMENTS",
      "contentHtml": null
    },
    {
      "id": "7bfd6f45-6887-ef11-8474-000d3a37e3b6",
      "type": "GeneralText",
      "area": "General",
      "position": 5,
      "content": "Each prerequisite course addresses one part of the portfolio development: ART 1040 the portfolio and visual media creation, and JOUR 2150 the content development Take one, based on consultation, for 3 units total: Track 1 Prerequisite: THEA 2500 - Script Analysis OR Track 2 Prerequisite: MUS 2150 - Introduction to Music Technology",
      "contentHtml": "<p>Each prerequisite course addresses one part of the portfolio development:</p><ul><li>ART 1040 the portfolio and visual media creation, and</li><li>JOUR 2150 the content development</li><li><strong>Take one, based on consultation, for 3 units total:</strong></li><li class=\"ql-indent-1\">Track 1 Prerequisite: THEA 2500 - Script Analysis <strong>OR</strong></li><li class=\"ql-indent-1\"><span style=\"color: rgb(29, 32, 36);\">Track 2 Prerequisite: MUS 2150 - Introduction to Music Technology&nbsp;</span></li></ul>"
    }
  ],
