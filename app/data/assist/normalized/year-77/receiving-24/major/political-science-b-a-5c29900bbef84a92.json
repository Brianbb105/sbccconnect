    {
      "id": "97046645-6887-ef11-8474-000d3a37e3b6",
      "type": "GeneralText",
      "area": "General",
      "position": 1,
      "content": "This agreement displays all lower-division courses required in the major : Stanislaus State courses or requirements on the left, approved (articulated) transfer courses on the right. Helpful resources: Academic Catalog Transfer Admissions Questions regarding this agreement may be directed to the Stanislaus State Articulation Analyst. Please visit the Stanislaus State Articulation Website for contact information.",
      "contentHtml": "<p>This agreement displays all<strong> lower-division courses required in the major</strong>: Stanislaus State courses or requirements on the left, approved (articulated) transfer courses on the right.</p><p><br></p><p><strong>Helpful resources: </strong></p><p><a href=\"https://catalog.csustan.edu/index.php\" rel=\"noopener noreferrer\" target=\"_blank\">Academic Catalog</a></p><p><a href=\"https://www.csustan.edu/undergrad/transfer-admission\" rel=\"noopener noreferrer\" target=\"_blank\">Transfer Admissions</a></p><p><br></p><p>Questions regarding this agreement may be directed to the Stanislaus State Articulation Analyst. Please visit the <a href=\"https://www.csustan.edu/articulation\" rel=\"noopener noreferrer\" target=\"_blank\">Stanislaus State Articulation Website</a> for contact information.</p>"
    },
    {
      "id": "7b337445-6887-ef11-8474-000d3a37e3b6",
      "type": "GeneralTitle",
      "area": "General",
      "position": 2,
      "content": "About the Major",
      "contentHtml": null
    },
    {
      "id": "b6f67645-6887-ef11-8474-000d3a37e3b6",
      "type": "GeneralText",
      "area": "General",
      "position": 3,
      "content": "The principal objectives of the undergraduate program are: To expose students to diverse concepts and theories in the major sub-areas of the discipline. To encourage students to think critically and creatively about politics. To provide appropriate pre-professional instruction to students who intend to enter graduate school, pursue a career in law or governmental affairs, or study for a teaching credential. View information for the Department of Political Science and Public Administration , including Learning Objectives for the department and its programs.",
      "contentHtml": "<p>The principal objectives of the undergraduate program are:</p><ul><li>To expose students to diverse concepts and theories in the major sub-areas of the discipline.</li><li>To encourage students to think critically and creatively about politics.</li><li>To provide appropriate pre-professional instruction to students who intend to enter graduate school, pursue a career in law or governmental affairs, or study for a teaching credential.</li></ul><p><br></p><p>View information for the <a href=\"https://catalog.csustan.edu/preview_entity.php?catoid=35&amp;ent_oid=1725\" rel=\"noopener noreferrer\" target=\"_blank\">Department of Political Science and Public Administration</a>, including Learning Objectives for the department and its programs.</p>"
    }
