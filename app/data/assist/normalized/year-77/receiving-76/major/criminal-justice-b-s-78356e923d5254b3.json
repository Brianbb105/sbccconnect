      "contentHtml": "<p><a href=\"https://www.calstate.edu/apply\" rel=\"noopener noreferrer\" target=\"_blank\" style=\"font-size: 16px;\">Cal State Apply</a></p><p><a href=\"http://www.calstatela.edu/\" rel=\"noopener noreferrer\" target=\"_blank\" style=\"font-size: 16px;\">Cal State LA</a><a href=\"https://ecatalog.calstatela.edu/preview_program.php?catoid=70&amp;poid=31599\" rel=\"noopener noreferrer\" target=\"_blank\" style=\"font-size: 16px;\"> </a></p><p><a href=\"http://www.calstatela.edu/hhs\" rel=\"noopener noreferrer\" target=\"_blank\" style=\"font-size: 16px;\">Rongxiang Xu College of Health and Human Services</a></p><p><a href=\"https://www.calstatela.edu/hhs/ac\" rel=\"noopener noreferrer\" target=\"_blank\" style=\"font-size: 16px;\">Rongxiang Xu College of Health and Human Services Advising Center</a></p><p><a href=\"http://adegreewithaguarantee.com/\" rel=\"noopener noreferrer\" target=\"_blank\" style=\"font-size: 16px;\">Degree with a Guarantee</a><a href=\"http://www.calstatela.edu/hhs/ac\" rel=\"noopener noreferrer\" target=\"_blank\" style=\"font-size: 16px;\"> </a></p><p><a href=\"https://www.calstatela.edu/hhs/crim\" rel=\"noopener noreferrer\" target=\"_blank\" style=\"font-size: 16px;\">School of Criminal Justice and Criminalistics</a></p><p><a href=\"https://ecatalog.calstatela.edu/content.php?catoid=77&amp;navoid=11897\" rel=\"noopener noreferrer\" target=\"_blank\" style=\"font-size: 16px;\">General Education Lower Division Courses </a></p><p><a href=\"http://ecatalog.calstatela.edu/\" rel=\"noopener noreferrer\" target=\"_blank\" style=\"font-size: 16px;\">University Catalog</a></p>"
