      "contentHtml": null
    },
    {
      "id": "34b66845-6887-ef11-8474-000d3a37e3b6",
      "type": "GeneralText",
      "area": "General",
      "position": 2,
      "content": "Chicano and Latino Studies departmental language requirement: Students must take two years of college Spanish or SPAN 250 or achieve a score of 4 or above on the high school advanced placement (AP) exam in Spanish language or literature or successful completion of a proficiency exam. Consult the CSULB Catalog for additional details.",
      "contentHtml": "<p>Chicano and Latino Studies departmental language requirement: Students must take two years of college Spanish or SPAN 250 or achieve a score of 4 or above on the high school advanced placement (AP) exam in Spanish language or literature or successful completion of a proficiency exam.</p><p><br></p><p><strong>Consult </strong>the <a href=\"https://csulb.catalog.acalog.com/preview_program.php?catoid=12&amp;poid=6264\" rel=\"noopener noreferrer\" target=\"_blank\">CSULB Catalog</a> for additional details.</p>"
    }
