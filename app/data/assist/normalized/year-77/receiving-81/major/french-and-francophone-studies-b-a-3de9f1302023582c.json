    {
      "id": "d5b66845-6887-ef11-8474-000d3a37e3b6",
      "type": "GeneralText",
      "area": "General",
      "position": 2,
      "content": "The number of lower-division units for majoring in French will depend on the amount of French studied previously in high school or college. Group 1: The prerequisite course does not count toward the required 33 units). Group 2: The course needs prior approval by the French Undergraduate Advisor. Consult the CSULB Catalog for additional details.",
      "contentHtml": "<p>The number of lower-division units for majoring in French will depend on the amount of French studied previously in high school or college.</p><p><br></p><p>Group 1: The prerequisite course does not count toward the required 33 units).</p><p><br></p><p>Group 2: The course needs prior approval by the French Undergraduate Advisor.</p><p><br></p><p>Consult the<a href=\"https://csulb.catalog.acalog.com/preview_program.php?catoid=12&amp;poid=6337\" rel=\"noopener noreferrer\" target=\"_blank\"> CSULB Catalog</a> for additional details.</p>"
    }
