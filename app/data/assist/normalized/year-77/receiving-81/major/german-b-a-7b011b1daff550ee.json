      "contentHtml": null
    },
    {
      "id": "c9b46845-6887-ef11-8474-000d3a37e3b6",
      "type": "GeneralText",
      "area": "General",
      "position": 2,
      "content": "One year of intermediate German or equivalent. Students who have completed sufficient high-school German may take upper-division courses as soon as lower-division requirements have been met. Native speakers of German may not enroll for credit in GERM 101A or 101B or 201A or 201B. Consult the CSULB Catalog for additional details.",
      "contentHtml": "<p>One year of intermediate German or equivalent.</p><p><br></p><p>Students who have completed sufficient high-school German may take upper-division courses as soon as lower-division requirements have been met.</p><p><br></p><p>Native speakers of German may not enroll for credit in GERM 101A or 101B or 201A or 201B.</p><p><br></p><p>Consult the <a href=\"https://csulb.catalog.acalog.com/preview_program.php?catoid=12&amp;poid=6339\" rel=\"noopener noreferrer\" target=\"_blank\">CSULB Catalog </a>for additional details.</p>"
    }
