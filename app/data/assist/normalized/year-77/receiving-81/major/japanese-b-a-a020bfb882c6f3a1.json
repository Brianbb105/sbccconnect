      "contentHtml": null
    },
    {
      "id": "4bb56845-6887-ef11-8474-000d3a37e3b6",
      "type": "GeneralText",
      "area": "General",
      "position": 2,
      "content": "All students must achieve a ‘C’ or better grade in all required and elective classes in the major to continue in the program. JAPN 201 and 202 may be satisfied by appropriate high school preparation or by examination. Consult the CSULB Catalog for additional details.",
      "contentHtml": "<p>All students must achieve a ‘C’ or better grade in all required and elective classes in the major to continue in the program.&nbsp;</p><p><br></p><p>JAPN 201 and 202 may be satisfied by appropriate high school preparation or by examination.</p><p><br></p><p><strong>Consult </strong>the <a href=\"https://csulb.catalog.acalog.com/preview_program.php?catoid=12&amp;poid=6232\" rel=\"noopener noreferrer\" target=\"_blank\">CSULB Catalog</a> for additional details.</p>"
    }
